{
  "name": "dodgeball-ultra-web-tools",
  "private": true,
  "description": "Asset pipeline + test harness for the Dodgeball Ultra web build (docs/). Not needed to play.",
  "type": "module",
  "scripts": {
    "assets": "python3 build_assets.py",
    "vendor": "node vendor.mjs",
    "serve": "node serve.mjs",
    "smoke": "node smoke.mjs",
    "test": "node --test \"../../docs/js/**/*.test.js\""
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "cannon-es": "0.20.0",
    "fbx2gltf": "0.9.7-p1",
    "playwright-core": "^1.56.1",
    "three": "0.186.1"
  }
}
