# Keep the tooling projects (these are not Unity-generated)
!/Tools/**/*.csproj

# Downloaded third-party content (fetched by the Setup Wizard or Tools/fetch_rocketbox.py).
# ~90 MB per realistic avatar - re-download instead of committing.
/Assets/ThirdParty/Rocketbox/
/Assets/ThirdParty/Rocketbox.meta
/Assets/ThirdParty/PolyHaven/
/Assets/ThirdParty/PolyHaven.meta

# Generated by the Setup Wizard
/Assets/DodgeballUltra/Generated/
/Assets/DodgeballUltra/Generated.meta

# Compile-check tool outputs
/Tools/CompileCheck/.cache/
/Tools/CompileCheck/**/bin/
/Tools/CompileCheck/**/obj/
/Tools/CoreTests/bin/
/Tools/CoreTests/obj/
__pycache__/
